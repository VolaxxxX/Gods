# Godot 4 .gitignore

# Godot-generated editor & import caches (regenerated on open / --import).
.godot/
# Per-asset import metadata + compiled translations (regenerated from source
# assets; this project treats art as drop-in, so we don't track the churn).
*.import
*.translation

# Exported builds.
/builds/
/export/
*.pck
*.zip

# OS / editor cruft.
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Mono / C# (unused for now, kept for safety).
.mono/
mono_crash.*.json
